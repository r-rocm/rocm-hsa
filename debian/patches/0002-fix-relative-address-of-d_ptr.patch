Subject: fix relative address of d_ptr

---
 src/core/util/lnx/os_linux.cpp | 12 +++++++++++-
 1 file changed, 11 insertions(+), 1 deletion(-)

diff --git a/src/core/util/lnx/os_linux.cpp b/src/core/util/lnx/os_linux.cpp
index d36dc0d..50a5b89 100644
--- a/src/core/util/lnx/os_linux.cpp
+++ b/src/core/util/lnx/os_linux.cpp
@@ -65,6 +65,16 @@
 #include <cpuid.h>
 #endif
 
+#ifdef __GLIBC__
+#if (defined(__riscv) && __riscv_xlen == 64)
+#define ABS_ADDR(base, ptr) ((base) + (ptr))
+#else
+#define ABS_ADDR(base, ptr) (ptr)
+#endif // (defined(__riscv) && __riscv_xlen == 64)
+#else
+#define ABS_ADDR(base, ptr) ((base) + (ptr))
+#endif // __GLIBC__
+
 namespace rocr {
 namespace os {
 
@@ -303,7 +313,7 @@ static int callback(struct dl_phdr_info* info, size_t size, void* data) {
         for (int j = 0;; j++) {
           if (dyn_section[j].d_tag == DT_NULL) break;
 
-          if (dyn_section[j].d_tag == DT_STRTAB) strings = (char*)(dyn_section[j].d_un.d_ptr);
+          if (dyn_section[j].d_tag == DT_STRTAB) strings = (char*)ABS_ADDR(info->dlpi_addr, dyn_section[j].d_un.d_ptr);
 
           if (dyn_section[j].d_tag == DT_STRSZ) limit = dyn_section[j].d_un.d_val;
         }
